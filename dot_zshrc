# Only run interactive shell configuration for interactive sessions.
[[ $- != *i* ]] && return

# Editor
export EDITOR="nvim"
export VISUAL="$EDITOR"

# History
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt append_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify

# Completion
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select

# FZF
export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_DEFAULT_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

[[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh

# Aliases
alias ls='eza --group-directories-first'
alias l='eza -lah --group-directories-first'
alias ll='ls -lah'
alias gs='git status'
alias cat='bat --style=plain --paging=never'
alias npm='pnpm'
alias npx='pnpm dlx'

fzfbat() {
    fzf --preview='bat --theme=gruvbox-dark --color=always {}'
}

fzfnvim() {
    local file
    file="$(fzf --preview='bat --theme=gruvbox-dark --color=always {}')" || return
    [[ -n "$file" ]] && nvim "$file"
}

# FNM / Node.js
export FNM_DIR="$HOME/.local/share/fnm"
command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd --shell zsh)"

# Zoxide
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Atuin
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"

# Starship prompt
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# Terminal multiplexer
TERMINAL_MULTIPLEXER="${TERMINAL_MULTIPLEXER:-zellij}"

start_terminal_multiplexer_if_needed() {
    [[ $- != *i* ]] && return
    [[ ! -t 1 ]] && return
    [[ -n "$TMUX" || -n "$ZELLIJ" ]] && return
    [[ "$TERMINAL_MULTIPLEXER" == "none" ]] && return

    if command -v "$TERMINAL_MULTIPLEXER" >/dev/null 2>&1; then
        exec "$TERMINAL_MULTIPLEXER"
    fi
}

start_terminal_multiplexer_if_needed
