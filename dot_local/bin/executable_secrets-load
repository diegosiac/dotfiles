#!/usr/bin/env zsh

function {
    local _secrets_load_token=""
    local _secrets_load_server=""
    local _secrets_load_status=0

    unset ENGRAM_CLOUD_TOKEN ENGRAM_CLOUD_SERVER

    if ! command -v op >/dev/null 2>&1; then
        print -u2 -r -- "secrets-load: 1Password CLI not found"
        return 1
    fi

    _secrets_load_token="$(op item get engram-cloud --field password --reveal 2>/dev/null)"
    _secrets_load_status=$?

    if (( _secrets_load_status != 0 )); then
        print -u2 -r -- "secrets-load: unable to read ENGRAM_CLOUD_TOKEN"
        return "$_secrets_load_status"
    fi

    if [[ -z "$_secrets_load_token" ]]; then
        print -u2 -r -- "secrets-load: ENGRAM_CLOUD_TOKEN was empty"
        return 1
    fi

    _secrets_load_server="$(op item get engram-cloud --field server --reveal 2>/dev/null)"
    _secrets_load_status=$?

    if (( _secrets_load_status != 0 )); then
        print -u2 -r -- "secrets-load: unable to read ENGRAM_CLOUD_SERVER"
        return "$_secrets_load_status"
    fi

    _secrets_load_server="${_secrets_load_server%$'\r'}"

    if [[ -z "$_secrets_load_server" ]]; then
        print -u2 -r -- "secrets-load: ENGRAM_CLOUD_SERVER was empty"
        return 1
    fi

    if [[ "$_secrets_load_server" != *://* ]]; then
        _secrets_load_server="https://$_secrets_load_server"
    fi

    typeset -gx ENGRAM_CLOUD_TOKEN="$_secrets_load_token"
    typeset -gx ENGRAM_CLOUD_SERVER="$_secrets_load_server"
    print -r -- "Loaded secrets: ENGRAM_CLOUD_TOKEN ENGRAM_CLOUD_SERVER"
}
