#!/bin/sh
set -eu

exec systemd-run --user --pipe --wait --collect \
  --property="LoadCredentialEncrypted=paul-mcp-email:$HOME/.config/credstore.encrypted/paul-mcp-email" \
  --property="LoadCredentialEncrypted=paul-mcp-password:$HOME/.config/credstore.encrypted/paul-mcp-password" \
  "$HOME/.local/bin/paul-mcp-service"
