#!/usr/bin/env zsh

function {
    local _secrets_load_token=""
    local _secrets_load_status=0

    unset ENGRAM_CLOUD_TOKEN

    if ! command -v op >/dev/null 2>&1; then
        print -u2 -r -- "secrets-load: 1Password CLI not found"
        return 1
    fi

    _secrets_load_token="$(op read 'op://secrets/engram-cloud/password' 2>/dev/null)"
    _secrets_load_status=$?

    if (( _secrets_load_status != 0 )); then
        print -u2 -r -- "secrets-load: unable to read ENGRAM_CLOUD_TOKEN"
        return "$_secrets_load_status"
    fi

    if [[ -z "$_secrets_load_token" ]]; then
        print -u2 -r -- "secrets-load: ENGRAM_CLOUD_TOKEN was empty"
        return 1
    fi

    typeset -gx ENGRAM_CLOUD_TOKEN="$_secrets_load_token"
    print -r -- "Loaded secrets: ENGRAM_CLOUD_TOKEN"
}
