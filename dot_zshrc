# Only run interactive shell configuration for interactive sessions.
[[ $- != *i* ]] && return

# History
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt append_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify

# Completion
typeset -U fpath
fpath=(/usr/share/zsh/site-functions $fpath)

autoload -Uz compinit
compinit

zstyle ':completion:*' menu select

# Carapace completions
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
command -v carapace >/dev/null 2>&1 && source <(carapace _carapace)

# FZF
export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

[[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh

# FZF tab completion UI must load after FZF completion to own the final Tab binding.
if [[ -f /usr/share/fzf-tab/fzf-tab.plugin.zsh ]]; then
    source /usr/share/fzf-tab/fzf-tab.plugin.zsh
elif [[ -f /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh ]]; then
    source /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
fi

# Curated native Zsh ports of Omarchy's interactive shell helpers.
omarchy_interactive_file="$HOME/.config/zsh/omarchy-interactive.zsh"
if [[ -r "$omarchy_interactive_file" ]]; then
    source "$omarchy_interactive_file"
fi
unset omarchy_interactive_file

# User aliases
alias gs='git status'
alias cat='bat --style=plain --paging=never'
alias npm='pnpm'
alias npx='pnpm dlx'

secrets-load() {
    source "$HOME/.local/bin/secrets-load"
}

secrets-clear() {
    unset ENGRAM_CLOUD_TOKEN
    print "Cleared secrets: ENGRAM_CLOUD_TOKEN"
}

# Mise runtime manager
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# Zoxide
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Atuin
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"

# Zsh suggestions and syntax highlighting
[[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

if [[ -f /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ]]; then
    source /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
elif [[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Starship prompt
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# Installer-managed blocks below. Keep the marker comments intact: Railway and
# pnpm look for them to update their block instead of appending a duplicate.
# The only edit is the -f guard, so fresh machines without the env file do not
# error on every shell start.

# >>> railway initialize >>>
[[ -f "$HOME/.railway/env" ]] && source "$HOME/.railway/env"
# <<< railway initialize <<<

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end
